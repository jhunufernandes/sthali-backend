<nav class="navbar fixed-top navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="#">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/4f/SVG_Logo.svg/960px-SVG_Logo.svg.png"
                alt="Logo" width="30" height="30" class="d-inline-block align-text-top me-2">
            <span>{{ title }}</span>
        </a>

        <button class="btn btn-outline-outline-secondary" type="button" data-bs-toggle="offcanvas"
            data-bs-target="#offcanvasNav" aria-controls="offcanvasNav" aria-label="Toggle menu">
            <span class="d-none d-lg-inline">›</span>
            <span class="d-lg-none">☰</span>
        </button>

        {% include 'components/navbar-large.html' with context %}
        <!-- {% include 'components/navbar-search-large.html' with context %}
        {% include 'components/navbar-user-session-large.html' with context %} -->
    </div>

</nav>

<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNav" aria-labelledby="offcanvasNavLabel">
    <div class="offcanvas-header">
        <!-- <h5 class="offcanvas-title" id="offcanvasNavLabel">Menu</h5> -->
        <button type="button" class="btn-outline-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="navbar-nav mb-3">
            {% for crudmodel in crudmodels.values() %}
                <li class="nav-item"><a class="nav-link" href="{{ crudmodel.view_read_many }}">{{ crudmodel.title }}</a></li>
            {% endfor %}
        </ul>

        {% include 'components/navbar-small.html' with context %}
        <!-- {% include 'components/navbar-search-small.html' with context %}
        {% include 'components/navbar-user-session-small.html' with context %} -->
    </div>
</div>